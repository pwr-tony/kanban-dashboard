# Copia este archivo a .env y ajusta los valores. Lo usan `go run ./cmd/api`
# (godotenv) y docker-compose. .env no se versiona.

# --- API ---
USERVAR_HTTP_PORT=8080
USERVAR_CORS_ORIGIN=*
# Carpeta del frontend que sirve el binario (vacío = no servir estáticos)
USERVAR_STATIC_DIR=frontend

# --- Base de datos (el usuario de la app solo necesita DML) ---
USERVAR_DB_HOST=localhost
USERVAR_DB_PORT=3306
USERVAR_DB_USER=kanban
USERVAR_DB_PASSWORD=kanban
USERVAR_DB_NAME=kanban
# Solo docker-compose: contraseña root del contenedor MySQL
MYSQL_ROOT_PASSWORD=root

# --- Autenticación ---
# Genera uno propio: openssl rand -base64 48
USERVAR_JWT_SECRET=cambia-este-secreto

# --- Cifrado por sobre de datos personales (KEK/DEK) ---
# Cada llave: 32 bytes aleatorios en base64 -> openssl rand -base64 32
# Sin USERVAR_KEK y USERVAR_BLIND_INDEX_KEY la API no arranca.
# ¡Si pierdes la KEK, los nombres y emails cifrados son irrecuperables!
USERVAR_KEK_ID=v1
USERVAR_KEK=
# Solo durante una rotación: KEKs anteriores "id:base64,id:base64"
USERVAR_KEK_RETIRED=
# Llave del índice ciego (búsqueda por email). Distinta de la KEK y NO se rota
# a la ligera: cambiarla invalida la búsqueda de todos los emails.
USERVAR_BLIND_INDEX_KEY=
